{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/processor/:path*", "destination": "/api/upstream/processor/:path*" },
    { "source": "/simulator/:path*", "destination": "/api/upstream/simulator/:path*" }
  ],
  "functions": {
    "api/[...path].js": {
      "maxDuration": 300
    }
  }
}
