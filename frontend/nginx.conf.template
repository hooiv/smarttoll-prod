server {
    listen 80;
    listen [::]:80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_vary on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml image/svg+xml;
    gzip_min_length 1024;

    # SSE must not be buffered, or the console never sees a new charge.
    location /api/v1/stream {
        proxy_pass ${BILLING_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-API-KEY "${BILLING_API_KEY}";
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        gzip off;
        proxy_read_timeout 3600s;
        add_header X-Accel-Buffering no;
    }

    location /processor/stream {
        proxy_pass http://toll_processor:8080/stream;
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        gzip off;
        proxy_read_timeout 3600s;
        add_header X-Accel-Buffering no;
    }

    # Same-origin proxy. The API key stays on the server; the browser calls /api.
    location /api/ {
        proxy_pass ${BILLING_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Request-ID $request_id;
        proxy_set_header X-API-KEY "${BILLING_API_KEY}";
    }

    # Processor and simulator expose health and the map read model.
    # The browser never talks to those ports directly.
    location /processor/ {
        proxy_pass http://toll_processor:8080/;
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
    }

    location /simulator/ {
        proxy_pass http://obu_simulator:8082/;
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
    }

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
}
