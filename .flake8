[flake8]
max-line-length = 120
extend-ignore =
    # The services predate a formatter. These codes are the existing style,
    # not new defects. A wholesale reformat was left out so reviews stay about behavior.
    E111, E114, E117, E131, E221, E231, E261,
    E301, E302, E303, E305, E306, E402, E501, E701,
    F824, W292, W391, W503
exclude =
    .venv,
    venv,
    .git,
    __pycache__,
    frontend
